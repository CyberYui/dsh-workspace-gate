{
  "name": "dsh-workspace-gate",
  "version": "0.1.0",
  "type": "module",
  "description": "Per-workspace plugin and skill inventory, with optional per-workspace plugin gating.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberYui/dsh-workspace-gate.git"
  },
  "homepage": "https://github.com/CyberYui/dsh-workspace-gate#readme",
  "bugs": {
    "url": "https://github.com/CyberYui/dsh-workspace-gate/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "workspace",
    "skills",
    "gating"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}

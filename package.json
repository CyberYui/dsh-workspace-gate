{
  "name": "@cyberyui/dsh-workspace-isolate",
  "version": "0.2.3",
  "type": "module",
  "description": "Per-workspace plugin and skill inventory, with per-workspace plugin isolation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberYui/dsh-workspace-isolate.git"
  },
  "homepage": "https://github.com/CyberYui/dsh-workspace-isolate#readme",
  "bugs": {
    "url": "https://github.com/CyberYui/dsh-workspace-isolate/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "workspace",
    "skills",
    "gating"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node test/host-regression.mjs && node test/css-invariants.mjs",
    "verify": "node test/host-regression.mjs && node test/css-invariants.mjs"
  }
}
